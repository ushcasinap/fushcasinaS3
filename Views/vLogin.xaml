<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="fushcasinaS3.Views.vLogin"
    Title="VLogin">

    <VerticalStackLayout
        Padding="20"
        Spacing="15">

        <Label
            Text="INICIO DE SESIÓN"
            FontSize="20"
            HorizontalOptions="Center" />

        <Image
            Source="https://thumbs.dreamstime.com/b/login-icon-button-vector-illustration-isolated-white-background-127001787.jpg"
            WidthRequest="150"
            HorizontalOptions="Center" />

        <Image
            Source="login.jpg"
            WidthRequest="150"
            HorizontalOptions="Center" />

        <Grid
            RowSpacing="10"
            ColumnSpacing="10">

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label
                Text="Usuario:"
                Grid.Row="0"
                Grid.Column="0" />

            <Entry
                x:Name="txtUsuario"
                Placeholder="Ingrese un usuario"
                Grid.Row="0"
                Grid.Column="1" />

            <Label
                Text="Contraseña:"
                Grid.Row="1"
                Grid.Column="0" />

            <Entry
                x:Name="txtContrasena"
                Placeholder="Ingrese una contraseña"
                IsPassword="True"
                Grid.Row="1"
                Grid.Column="1" />

            <Button
                x:Name="btnIniciarSesion"
                Text="Iniciar Sesión"
                Clicked="btnIniciarSesion"
                Grid.Row="2"
                Grid.Column="0" />

            <Button
                x:Name="btnRegistrarUsuario"
                Text="Registrar Usuario"
                Clicked="btnRegistrarUsuario"
                Grid.Row="2"
                Grid.Column="1" />

        </Grid>

    </VerticalStackLayout>

</ContentPage>