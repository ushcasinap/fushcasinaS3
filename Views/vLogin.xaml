<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaS3.Views.vLogin"
             Title="vLogin">

    <ContentPage.Resources>
        <Style x:Key="styleLable" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="BackgroundColor" Value="Violet"/>
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="styleEntery" TargetType="Entry">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Blue"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout
        Padding="20"
        Spacing="15"
        BackgroundColor="Beige">
        <Label 
            Text="INCIO DE SESION"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <!--IMAGENES-->
        <!--1. Enlace web (jpg - png)-->

        <!--2. Archivo jpg - png dentro de los recursos-->

        <!--<Image Source="https://thumbs.dreamstime.com/b/login-icon-button-vector-illustration-isolated-white-background-127001787.jpg"
               WidthRequest="200"/>-->

        <Image Source="login.png"
               WidthRequest="200"/>

        <Grid HorizontalOptions="Center"
              VerticalOptions="Center"
              RowSpacing="10"
              ColumnSpacing="10">
            <Grid.RowDefinitions>

                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Text="Usuario"
                   Style="{StaticResource styleLable}"
                   Grid.Row="0"
                   Grid.Column="0"/>

            <Entry x:Name="txtUsuario"
                   Placeholder="Ingrese el usuario"
                   Style="{StaticResource styleEntery}"
                   Grid.Row="0"
                   Grid.Column="1">

            </Entry>

            <Label Text="Contrasena"
               Style="{StaticResource styleLable}"
               Grid.Row="1"
               Grid.Column="0"/>

            <Entry x:Name="txtContrasenia"
               Placeholder="Ingrese la contrasena"
               IsPassword="true"
               Style="{StaticResource styleEntery}"
               Grid.Row="1"
               Grid.Column="1">

            </Entry>

            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar Sesion"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0">

            </Button>

            <Button x:Name="btnRegistrarUsuario"
                    Text="Registrar Usuario"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Grid.Row="2"
                    Grid.Column="1">

            </Button>

        </Grid>

    </VerticalStackLayout>
</ContentPage>