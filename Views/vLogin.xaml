<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="fushcasinaS3.Views.vLogin"
             Title="vLogin"
             BackgroundColor="White">

    <ContentPage.Resources>
        <!-- Estilo para Label -->
        <Style x:Key="styleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="#8A2BE2"/>
            <!-- Morado -->
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>

        <!-- Estilo para Entry -->
        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Black"/>
            <!-- Beige -->
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>

        <!-- Estilo para Botón con degradado -->
        <Style x:Key="styleButton" TargetType="Button">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="1,0">
                        <GradientStop Color="#8A2BE2" Offset="0.0"/>
                        <!-- Morado -->
                        <GradientStop Color="#0000FF" Offset="1.0"/>
                        <!-- Azul -->
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label 
            Text="INICIO DE SESIÓN"
            FontSize="22"
            TextColor="Blue"
            HorizontalOptions="Center" />

        <Image Source="login.jpeg"
               WidthRequest="100"
               HorizontalOptions="Center"
               />

        <Grid RowSpacing="20" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Usuario -->
            <Label Text="Usuario:"
                   Style="{StaticResource styleLabel}"
                   Grid.Row="0"
                   Grid.Column="0"/>
            <Entry x:Name="txtUsuario"
                   Placeholder="Ingrese el usuario"
                   Style="{StaticResource styleEntry}"
                   Grid.Row="0"
                   Grid.Column="1"/>

            <!-- Contraseña -->
            <Label Text="Contraseña:"
                   Style="{StaticResource styleLabel}"
                   Grid.Row="1"
                   Grid.Column="0"/>
            <Entry x:Name="txtContrasenia"
                   Placeholder="Ingrese la contraseña"
                   IsPassword="True"
                   Style="{StaticResource styleEntry}"
                   Grid.Row="1"
                   Grid.Column="1"/>

            <!-- Botones -->
            <Button x:Name="btnIniciarSesion"
                    Text="Iniciar Sesión"
                    Style="{StaticResource styleButton}"
                    Clicked="btnIniciarSesion_Clicked"
                    Grid.Row="2"
                    Grid.Column="0"/>
            <Button x:Name="btnRegistrarUsuario"
                    Text="Registrar Usuario"
                    Style="{StaticResource styleButton}"
                    Clicked="btnRegistrarUsuario_Clicked"
                    Grid.Row="2"
                    Grid.Column="1"/>
        </Grid>
    </VerticalStackLayout>
</ContentPage>
